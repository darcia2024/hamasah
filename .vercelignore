# Yang tidak ikut ke Vercel.
#
# Aplikasi ini server Node, bukan situs statis. Yang dideploy adalah api/index.js
# beserta berkas yang dibutuhkannya saat berjalan (website/, assets/, data/,
# database/), diatur lewat "includeFiles" di vercel.json.
#
# Sisanya tidak perlu ikut, dan sebagian memang tidak boleh ikut: berkas test,
# dokumen internal, dan berkas environment.
.env
.env.*
.git
.github
node_modules
data/dev-db
docs
scripts/*.test.js
server/**/*.test.js
server/test-support
database/*.test.js
*.md
!README.md

# Lingkungan aplikasi: development, test, staging, atau production.
# Wajib diisi sebelum menjalankan skrip yang menulis ke database (migrate, seed, auth-live-check).
# Isi sesuai database yang dituju oleh DATABASE_URL di bawah, bukan sesuai perangkat yang dipakai.
APP_ENV=development
PORT=4273
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/hamasah
# Opsional: jumlah maksimal koneksi pool PostgreSQL, bilangan bulat 1 sampai 50 (default 5).
# DATABASE_POOL_MAX=5
# Opsional: koneksi khusus untuk migrasi. Pakai koneksi session (port 5432) atau koneksi langsung,
# bukan pooler mode transaksi. Jika kosong, migrasi memakai DATABASE_URL.
# DATABASE_MIGRATION_URL=postgresql://USER:PASSWORD@HOST:5432/hamasah
# Wajib jika APP_ENV=production.
STORAGE_BUCKET=hamasah-private-documents
# Jangan simpan secret production di file ini. Atur pada environment deployment.
# Hanya dibutuhkan sampai akun admin pertama dibuat, lalu hapus. Minimal 32 karakter jika diisi.
HAMASAH_BOOTSTRAP_KEY=ganti-dengan-rahasia-panjang

# Email: console hanya untuk development/test. Untuk staging/production, gunakan
# EMAIL_DRIVER=resend dan isi tiga nilai berikut di environment deployment.
EMAIL_DRIVER=console
APP_BASE_URL=http://localhost:4273
EMAIL_FROM=Hamasah International <noreply@example.test>
RESEND_API_KEY=

{
  "name": "hamasah-international",
  "private": true,
  "version": "0.1.0",
  "description": "Website publik dan portal operasional Hamasah International.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node scripts/dev.js",
    "dev:reset": "node scripts/dev-reset.js",
    "migrate": "node database/migrate.js",
    "verify:database": "node database/verify.js",
    "seed:articles": "node database/seed-articles.js",
    "check:docker": "node scripts/check-docker-context.js",
    "release:check": "node scripts/release-gate.js",
    "smoke-test": "node scripts/smoke.js",
    "worker:notifications": "node scripts/notification-worker.js",
    "worker:visa-reminders": "node scripts/visa-reminder-worker.js --once",
    "test:browser-contract": "node scripts/browser-contract.test.js",
    "test:csp-contract": "node scripts/csp-contract.test.js",
    "check:contrast": "node scripts/contrast-check.js",
    "test:performance": "node scripts/performance-smoke.test.js",
    "test:role-authorization": "node scripts/role-authorization.test.js",
    "test:http-performance": "node scripts/http-performance.test.js",
    "security:check": "node scripts/security-local-check.js",
    "preflight:staging": "node scripts/staging-preflight.js",
    "cleanup:smoke-data": "node scripts/cleanup-smoke-data.js",
    "test": "node database/validate-schema.js && node --test"
  },
  "dependencies": {
    "pg": "8.12.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8"
  }
}

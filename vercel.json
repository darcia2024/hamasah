{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "buildCommand": "node scripts/vercel-static.js",
  "outputDirectory": "vercel-static",
  "regions": [
    "sin1"
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": "{website,assets,data,database}/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js?__path=$1"
    }
  ],
  "crons": [
    {
      "path": "/api/tasks/maintenance",
      "schedule": "0 20 * * *"
    }
  ]
}
